SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connections
# asyncpg is used for the async API endpoints
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
# psycopg2 is used for sync migrations/DB init
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres

# AI Configuration
# If GEMINI_API_KEY is set, Gemini is used for both embeddings and chat.
# OpenAI is only used as a fallback when no Gemini key is configured.
# If neither is set, the app runs in a fully deterministic mock mode.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_LLM_MODEL=models/gemini-3.6-flash

OPENAI_API_KEY=your-openai-key
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# LangChain Tracing
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=cardiocompass
